# Environment Variables Example
# Copy this file to .env and update the values

# Database Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=bankwesen_db

# Service URLs (for Gateway)
AUTH_SERVICE_URL=http://auth_service:8001
OTP_SERVICE_URL=http://otp_service:8002
PAYMENT_SERVICE_URL=http://payment_service:8003
NOTIFICATION_SERVICE_URL=http://notification_service:8004
TUITION_SERVICE_URL=http://tuition_service:8005

# Auth Service
AUTH_DATABASE_URL=postgresql://user:password@postgres:5432/auth_db
SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OTP Service
REDIS_URL=redis://redis:6379/0
OTP_EXPIRATION_MINUTES=10

# Payment Service
PAYMENT_DATABASE_URL=postgresql://user:password@postgres:5432/payment_db

# Notification Service
NOTIFICATION_DATABASE_URL=postgresql://user:password@postgres:5432/notification_db
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMS_API_KEY=your-sms-api-key

# Tuition Service
TUITION_DATABASE_URL=postgresql://user:password@postgres:5432/tuition_db

# General Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
