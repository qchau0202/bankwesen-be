# MongoDB Configuration
MONGODB_URL=mongodb://mongodb:27017
DATABASE_NAME=payment_db

# JWT Configuration (MUST match auth service for token validation)
SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Key Configuration
API_KEY=bankwesen-api-key-2024-secure-change-in-production
ENABLE_API_KEY=true

# Service Configuration
SERVICE_NAME=Payment Service
SERVICE_PORT=8003

# External Services Configuration
OTP_SERVICE_URL=http://otp_service:8004
TUITION_SERVICE_URL=http://tuition_service:8005
NOTIFICATION_SERVICE_URL=http://notification_service:8006
