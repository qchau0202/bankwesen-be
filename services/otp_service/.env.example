# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRATION=60
OTP_MAX_ATTEMPTS=3
OTP_ATTEMPT_WINDOW=300

# Service Configuration
SERVICE_NAME=OTP Service
SERVICE_PORT=8002

# External Services
NOTIFICATION_SERVICE_URL=http://notification_service:8004
MONGODB_URL=mongodb://mongodb:27017/otp_db

# API Security
API_KEY=bankwesen-api-key-2024-secure-change-in-production
API_KEY_NAME=X-API-Key
ENABLE_API_KEY=true
